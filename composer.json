{
  "name": "bwtech/guests",
  "description": "Share with externals easily via email address (PHP 8.4 fork of owncloud/guests for owncloud.online)",
  "modified-by": "BW-Tech GmbH",
  "config": {
    "platform": {
      "php": "8.4"
    },
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  },
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "OCA\\Guests\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\Guests\\Tests\\": "tests/"
    }
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": false
    }
  }
}
